-- Домашка 3. Просто типизированное лямбда-исчисление.
-- Решения пишутся на месте дырок `...`. Проверка: `make check`. Как пишутся термы и проверки — lambda-engine/README.md.
-- Интерпретатор: `make repl`; как им пользоваться — lambda-engine/TUTORIAL.md: раздел 6 (типы) и 7–8 про правку файла и проверку.
-- Типы: a, b, c — переменные типов; a -> b -> c читается как a -> (b -> c).
-- Язык typed: доступны аннотации по Чёрчу (\x:a. x), типы Int и Bool,
-- литералы 0, 1, 2, …, операторы + - * < == (как на практике: x + 1, x < 2) и if, true, false.
--
-- Ответом на вопрос о типе может быть `none` — «типа нет».

language typed


-- ============================================================
-- Комбинаторы с лекции (типизируются по Карри). Менять их не нужно.
-- ============================================================

I  := \x. x
K  := \x y. x
K' := \x y. y
S  := \x y z. x z (y z)
B  := \f g x. f (g x)
C  := \f x y. f y x


-- ============================================================
-- Уровень 1. Обязательные задачи
-- ============================================================

task 1.1 (типы термов с числами и булями)
-- Предскажите тип каждого терма — сначала в голове, как на практике, и только потом
-- сверяясь с интерпретатором (`make repl`, команда `:type`). Формат: `type t = Int -> Int`.

t1_1a := \x. x + 1
type t1_1a = ...

t1_1b := \b. if b 0 1
type t1_1b = ...

t1_1c := \f x. if (f x) x (x + 1)
type t1_1c = ...

t1_1d := true + 1
type t1_1d = ...


task 1.2 (наиболее общий тип: буквы и константы)
-- Найдите наиболее общий тип. Например, у K наиболее общий тип a -> b -> a:
-- K : a -> a -> a — корректная типизация, но не наиболее общая.

t1_2a := \b:Bool x:a y:a. if b x y
type t1_2a = ...

t1_2b := \x:(a -> a). x
type t1_2b = ...

t1_2c := \x. x
type t1_2c = ...

-- Две переменные с одним именем: какая из них возвращается?
t1_2d := \x x. x
type t1_2d = ...

t1_2e := \x y. x y
type t1_2e = ...

-- Тот же терм, что t1_2a, но без аннотаций: буквы и константы в одном типе.
t1_2f := \b x y. if b x y
type t1_2f = ...


task 1.3 (наиболее общий тип: продолжение)
-- Сначала руками: какие равенства типов требует каждый терм и совместимы ли они.

t1_3a := \x. x K I x
type t1_3a = ...

t1_3b := \f. f 1 + f true
type t1_3b = ...

t1_3c := \f. f 1 + f 2
type t1_3c = ...


task 1.4 (население: базовые типы)
-- Населите тип замкнутыми термами: определите обитателей отдельными именами и перечислите
-- их после двоеточия. αβη-эквивалентные термы не считаются. Если обитателей нет — `none`.
-- Формат: `inhabit T: n1, n2`; число в скобках после типа — сколько обитателей нужно найти.

inhabit a -> a: ...

inhabit a -> a -> a (2): ...

inhabit a -> b -> a: ...

inhabit a: ...

inhabit Int (2): ...


-- ============================================================
-- Уровень 2. Задачи сложнее
-- ============================================================

task 2.1 (наиболее общий тип: сложнее)

t2_1a := \f g x y. f g (g x) (g y)
type t2_1a = ...

-- Константа внутри терма ограничивает часть букв, остальные остаются свободными.
t2_1b := \f g x. g (f x) (x + 1)
type t2_1b = ...


task 2.2 (типизация по Чёрчу: комбинаторы)
-- Перепишите комбинатор с аннотацией \x:T у каждого связывателя так, чтобы
-- получился его наиболее общий тип. Пример: I по Чёрчу — \x:a. x.
-- Формат: `church K = \x:… y:…. x`.

church K = ...

church B = ...


task 2.3 (население: два и бесконечно много)
-- family T: F — терм F, который на числах Чёрча ⌜0⌝, ⌜1⌝, … даёт попарно различных
-- обитателей T: так показывают, что обитателей бесконечно много.

inhabit a -> a -> a -> a (3): ...

inhabit a -> b -> (a -> b -> c) -> c: ...

family (a -> a) -> a -> a: ...

inhabit (a -> b -> b) -> b -> b: ...


-- Без автопроверки: на бумаге постройте дерево вывода для
--   ⊢ S : (a -> b -> c) -> (a -> b) -> a -> c
-- в стиле Карри, с правилами (акс), (→E), (→I), как на практике. Проверялка деревья
-- вывода не читает.


-- ============================================================
-- Уровень 3. Самые сложные задачи
-- ============================================================

task 3.1 (типизация по Чёрчу: аппликации комбинаторов)
-- Раскройте определения комбинаторов и снабдите каждый связыватель аннотацией так,
-- чтобы у всего терма получился наиболее общий тип. Пример: I K I по Чёрчу —
-- (\x:((a -> a) -> b -> a -> a). x) (\x:(a -> a) y:b. x) (\x:a. x) : b -> a -> a.

ski := S K I
church ski = ...

skk := S K K
church skk = ...


task 3.2 (население: посложнее)
-- Половина задания — один обитатель (inhabit), полное — бесконечно много (family).

inhabit ((a -> b) -> a) -> (a -> a -> b) -> b: ...
family ((a -> b) -> a) -> (a -> a -> b) -> b: ...

inhabit ((((a -> b) -> a) -> a) -> b) -> b: ...
family ((((a -> b) -> a) -> a) -> b) -> b: ...


-- Бонус без автопроверки: реализуйте комбинатор S на своём любимом типизированном
-- языке так, чтобы его тип был наиболее общим, и напишите тест, который это показывает.
